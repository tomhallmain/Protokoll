#: src/ui/tracker_dialog.py:135
msgid "Detected from the log file name"
msgstr "Обнаружено по имени файла журнала"

#: src/utils/file_handler.py:429 test/unit/test_file_handler.py:476
msgid "This file does not contain any readable encrypted log records."
msgstr "Этот файл не содержит читаемых зашифрованных записей журнала."

#: src/utils/file_handler.py:456
msgid ""
"Set the service name and app ID under \"Encrypted logs\" in this tracker's "
"settings to the ones the app writing this log uses."
msgstr ""
"Установите имя службы и ID приложения в разделе «Зашифрованные журналы» в "
"настройках этого трекера, используя те же значения, что использует "
"приложение, записывающее этот журнал."

#: src/utils/file_handler.py:459 test/unit/test_file_handler.py:425
msgid ""
"This log is encrypted, and there is no service name and app ID to look up "
"its key with."
msgstr ""
"Этот журнал зашифрован, и нет ни названия сервиса, ни ID приложения, чтобы "
"найти его ключ."

#: src/utils/file_handler.py:462
msgid "This log is encrypted, and no key found for it opens it (tried: {0})."
msgstr ""
"Этот журнал зашифрован, и не найдено ключей, которые могут открыть его "
"(попробовано: {0})."
